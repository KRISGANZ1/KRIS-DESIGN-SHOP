PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret

# Local SQLite is used when DATABASE_URL is unset.
# Configure a managed PostgreSQL URL for Vercel deployments.
DATABASE_URL=
DATABASE_SSL=
DATABASE_POOL_SIZE=5

# Required on Vercel for persistent product and QRIS image uploads.
BLOB_READ_WRITE_TOKEN=
