{
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/login/admin", "destination": "/index.html" },
    { "source": "/products", "destination": "/index.html" },
    { "source": "/product/:slug", "destination": "/index.html" },
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/payment", "destination": "/index.html" },
    { "source": "/orders", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" }
  ]
}
